{
  "name": "xal-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --watch apps/cli/src/index.ts",
    "dev:website": "turbo run dev --filter=xal-website",
    "build": "turbo run build",
    "build:website": "bun run --cwd apps/website build",
    "deploy:website": "wrangler deploy --config apps/website/wrangler.jsonc",
    "test": "turbo run test --",
    "release:local": "turbo run release:local --filter=xal",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "checks": "bun run typecheck && bun run lint && bun run format && bun run test",
    "checks:fix": "bun run lint:fix && bun run format:fix && bun run checks"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.10",
    "wrangler": "^4.123.0"
  }
}
