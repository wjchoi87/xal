{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "test": {
      "outputs": []
    },
    "release:local": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    }
  }
}
